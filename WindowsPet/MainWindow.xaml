<Window x:Class="DesktopPet.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        Width="360"
        Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Canvas x:Name="Root">
        <Ellipse x:Name="Shadow"
                 Width="132"
                 Height="22"
                 Fill="#26000000"
                 Canvas.Left="114"
                 Canvas.Top="334"
                 IsHitTestVisible="False" />

        <Canvas x:Name="ParticleLayer"
                Width="360"
                Height="430"
                IsHitTestVisible="False" />

        <Border x:Name="Bubble"
                Visibility="Collapsed"
                Background="#B8FFFFFF"
                BorderBrush="#55FFE66D"
                BorderThickness="1"
                CornerRadius="13"
                Padding="10,4"
                Canvas.Top="34"
                IsHitTestVisible="False">
            <TextBlock x:Name="BubbleText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CC20202A" />
        </Border>

        <Image x:Name="PetImage"
               Width="190"
               Height="240"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.55"
               Canvas.Left="85"
               Canvas.Top="98"
               MouseLeftButtonDown="Pet_MouseLeftButtonDown"
               MouseLeftButtonUp="Pet_MouseLeftButtonUp"
               MouseMove="Pet_MouseMove"
               MouseRightButtonUp="Pet_MouseRightButtonUp">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScaleTransform" />
                    <RotateTransform x:Name="PetRotateTransform" />
                    <TranslateTransform x:Name="PetTranslateTransform" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Canvas>
</Window>
